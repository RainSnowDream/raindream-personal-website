{
  // Worker 名称与兼容日期沿用当前线上的值（从 Cloudflare API 读到的，没有改动）
  "name": "raindream-personal-website",
  "compatibility_date": "2026-10-06",

  // 我们的 Worker 脚本：只负责给 /audio/* 补上分段下载（Range）能力
  // 说明见 src/worker.js 顶部的长注释
  "main": "src/worker.js",

  // 静态资源就是仓库根目录（现在就是这个行为）
  "assets": {
    "directory": "./",

    // 只让 /audio/ 下的请求「先」经过 Worker；其余路径仍由静态资源直接服务
    "run_worker_first": ["/audio/*"],

    // Worker 里要用 env.ASSETS.fetch() 取文件，所以绑定必须起个名字
    "binding": "ASSETS",

    // 关键的一行：找不到匹配文件时，返回最近的 404.html，并且状态码是 404
    // 默认值是 "none"，也就是什么都不返回（访客看到的是一片空白）
    "not_found_handling": "404-page"
  }
}
